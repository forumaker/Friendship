{
  "name": "forumaker/friendship",
  "description": "Adds a friendship system",
  "type": "flarum-extension",
  "keywords": ["flarum", "flarum-extension", "friends", "friendship", "social"],
  "license": "MIT",
  "homepage": "https://github.com/forumaker/friendship",
  "support": {
    "issues": "https://github.com/forumaker/friendship/issues",
    "source": "https://github.com/forumaker/friendship"
  },
  "authors": [
    {
      "name": "forumaker",
      "role": "Developer",
      "email": "arsenygpt@gmail.com",
      "homepage": "https://github.com/forumaker"
    }
  ],
  "require": {
    "php": "^8.3",
    "flarum/core": "^2.0.0"
  },
  "require-dev": {
    "flarum/testing": "^2.0.0"
  },
  "autoload": {
    "psr-4": {
      "forumaker\\Friendship\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "forumaker\\Friendship\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.x-dev"
    },
    "flarum-extension": {
      "title": "Friendship",
      "category": "feature",
      "icon": {
        "name": "fas fa-hand-peace",
        "backgroundColor": "#45698D",
        "color": "#ffffff"
      }
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": ["@test:unit", "@test:integration"],
    "test:unit": "phpunit -c tests/phpunit.unit.xml",
    "test:integration": "phpunit -c tests/phpunit.integration.xml",
    "test:setup": "@php tests/integration/setup.php"
  },
  "scripts-descriptions": {
    "test": "Runs all tests.",
    "test:unit": "Runs all unit tests.",
    "test:integration": "Runs all integration tests.",
    "test:setup": "Sets up a database for use with integration tests. Execute this only once."
  }
}
